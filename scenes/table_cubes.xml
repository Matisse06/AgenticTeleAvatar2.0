<mujoco model="table_cubes">
  <!-- A table in front of the robot with a red and a green 4 cm cube on it, placed where either arm can grasp both
       from the front or the side (scenes/README.md). The 'home' keyframe is the robot's home with the cubes resting
       on the table. -->
  <include file="common/physics.xml"/>
  <include file="common/room.xml"/>
  <asset>
    <model name="teleavatar" file="../model/robot.xml"/>
  </asset>
  <statistic center="0.4 0 0.85" extent="1.6"/>
  <visual>
    <global azimuth="140" elevation="-20"/>
  </visual>
  <default>
    <default class="table">
      <geom type="box" rgba="0.78 0.74 0.68 1"/>
      <default class="table_leg">
        <geom size="0.02 0.02 0.36" rgba="0.35 0.35 0.38 1"/>
      </default>
    </default>
    <default class="cube">
      <geom type="box" size="0.02 0.02 0.02" mass="0.064"/>
    </default>
  </default>
  <worldbody>
    <!-- The robot at the origin, facing +x, with its own names (attached: common/physics.xml). Its base is fixed in
         table_cubes.xml and drivable in table_cubes_mobile.xml, which scenes/build_mobile.py writes. -->
    <attach model="teleavatar" body="base_link" prefix=""/>
    <!-- Views for people (the robot's own cameras are head, left_wrist, right_wrist), named as in model/scene.xml -->
    <camera name="overview" pos="1.95 -1.5 1.65" xyaxes="0.684 0.730 0 -0.242 0.227 0.944"/>
    <camera name="front" pos="1.9 0 1.5" xyaxes="0 1 0 -0.351 0 0.936"/>
    <camera name="left_side" pos="0.55 1.9 1.75" xyaxes="-0.996 0.089 0 -0.037 -0.413 0.910"/>
    <!-- The top is at z = 0.75 m, 0.6 m deep (x 0.28 to 0.88; the front edge is 4 cm ahead of the robot's base),
         1.0 m wide and 3 cm thick, on four legs. To change the height, move the top and resize the legs together. -->
    <body name="table" pos="0.58 0 0">
      <geom name="table_top" class="table" size="0.3 0.5 0.015" pos="0 0 0.735"/>
      <geom name="table_leg1" class="table_leg" pos="-0.26 0.46 0.36"/>
      <geom name="table_leg2" class="table_leg" pos="-0.26 -0.46 0.36"/>
      <geom name="table_leg3" class="table_leg" pos="0.26 0.46 0.36"/>
      <geom name="table_leg4" class="table_leg" pos="0.26 -0.46 0.36"/>
    </body>
    <!-- 0.40 m ahead, 5 cm either side of the centre line, resting on the top (z = 0.75 + 0.02) -->
    <body name="red_cube" pos="0.4 0.05 0.77">
      <freejoint name="red_cube"/>
      <geom name="red_cube" class="cube" rgba="0.85 0.1 0.1 1"/>
    </body>
    <body name="green_cube" pos="0.4 -0.05 0.77">
      <freejoint name="green_cube"/>
      <geom name="green_cube" class="cube" rgba="0.1 0.65 0.2 1"/>
    </body>
  </worldbody>
</mujoco>
